# LLM provider: nvidia, huggingface, or demo
LLM_PROVIDER=nvidia

# NVIDIA API Catalog: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Optional Hugging Face Inference Providers alternative
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# With EMBEDDING_PROVIDER=auto, hosted NVIDIA embeddings are attempted when a key is set.
# If that model endpoint fails, Vigilix falls back to local deterministic hashing embeddings.
EMBEDDING_PROVIDER=auto

# SQLite is the zero-setup default. For Neon PostgreSQL, paste your pooled connection string:
# DATABASE_URL=postgresql://neondb_owner:password@ep-...pooler.us-east-2.aws.neon.tech/neondb
DATABASE_URL=sqlite:///./data/vigilix.db
CHROMA_PERSIST_DIR=./data/chroma
KNOWLEDGE_DIR=./data/knowledge
SAMPLE_LOGS_DIR=./data/sample_logs
API_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=10

# Allowed CORS origins for production frontend domains (comma-separated, e.g. https://app.vigilix.ai,https://vigilix.vercel.app)
CORS_ORIGINS=

# Auth: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Chat performance controls
CHAT_TEMPERATURE=0.1
CHAT_MAX_TOKENS=700
CHAT_HISTORY_TURNS=4
RAG_TOP_K=4
