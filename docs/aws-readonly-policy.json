{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudSentryCallerIdentity",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "CloudTrailEventHistoryReadOnly",
      "Effect": "Allow",
      "Action": ["cloudtrail:LookupEvents"],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyFindingsReadOnly",
      "Effect": "Allow",
      "Action": [
        "guardduty:ListDetectors",
        "guardduty:ListFindings",
        "guardduty:GetFindings"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubFindingsReadOnly",
      "Effect": "Allow",
      "Action": ["securityhub:DescribeHub", "securityhub:GetFindings"],
      "Resource": "*"
    },
    {
      "Sid": "OptionalCloudTrailS3List",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR_CLOUDTRAIL_BUCKET"
    },
    {
      "Sid": "OptionalCloudTrailS3GetObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::YOUR_CLOUDTRAIL_BUCKET/AWSLogs/YOUR_ACCOUNT_ID/CloudTrail/*"
    }
  ]
}
